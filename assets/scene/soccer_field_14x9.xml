<mujoco model="soccer_field_14x9">
  <!-- 14x9 m indoor soccer field with goals (goal.stl) and a standard
       size-5 ball (footaball.stl scaled to 0.22 m diameter).
       Field long axis = x, playing area x:[-7,7] y:[-4.5,4.5]. -->
  <compiler angle="radian" meshdir="." autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81"/>
  <visual>
    <global offwidth="1280" offheight="720"/>
  </visual>

  <statistic center="0 0 0.5" extent="10"/>

  <asset>
    <texture type="skybox" name="sky" builtin="gradient"
             rgb1="0.72 0.78 0.85" rgb2="0.95 0.96 0.97" width="512" height="512"/>
    <texture type="2d" name="grass_tex" file="grass_14x9.png"/>
    <material name="grass_mat" texture="grass_tex" texuniform="true"
              texrepeat="0.125 0.189" specular="0.1" shininess="0.15"
              reflectance="0.02"/>
    <mesh name="goal_mesh" file="goal.stl"/>
    <mesh name="ball_mesh" file="footaball.stl" scale="0.18514 0.18514 0.18514"/>
  </asset>

  <worldbody>
    <light name="sun" directional="true" pos="0 -4 8" dir="0 0.35 -1"
           diffuse="0.85 0.85 0.85" ambient="0.4 0.4 0.42" specular="0.15 0.15 0.15"/>
    <light name="fill" pos="6 -8 5" dir="-0.5 0.6 -0.6" diffuse="0.3 0.3 0.3" castshadow="false"/>

    <!-- grass plane: 16 x 11 m (1 m margin outside the 14x9 playing area) -->
    <geom name="field" type="plane" size="8 5.5 0.05" material="grass_mat"
          friction="1 0.005 0.0001"/>

    <!-- ============ left goal (opening faces +x) ============ -->
    <body name="goal_left" pos="-7.2533 0 0" euler="0 0 1.5708">
      <!-- visual mesh (opening faces -y in STL frame) -->
      <geom name="goal_left_vis" type="mesh" mesh="goal_mesh"
            contype="0" conaffinity="0" group="1" rgba="0.85 0.85 0.85 1"/>
      <!-- invisible collision: posts / crossbar / net box -->
      <geom name="goal_left_post_l" type="box" pos="-0.49 -0.06 0.2445" size="0.035 0.19 0.2445"
            contype="1" conaffinity="1" group="3" rgba="0 0 0 0"/>
      <geom name="goal_left_post_r" type="box" pos="0.49 -0.06 0.2445" size="0.035 0.19 0.2445"
            contype="1" conaffinity="1" group="3" rgba="0 0 0 0"/>
      <geom name="goal_left_bar" type="box" pos="0 -0.06 0.46" size="0.5 0.19 0.03"
            contype="1" conaffinity="1" group="3" rgba="0 0 0 0"/>
      <geom name="goal_left_roof" type="box" pos="0 -0.085 0.465" size="0.5 0.17 0.02"
            contype="1" conaffinity="1" group="3" rgba="0 0 0 0"/>
      <geom name="goal_left_back" type="box" pos="0 0.165 0.21" size="0.5 0.025 0.21"
            contype="1" conaffinity="1" group="3" rgba="0 0 0 0"/>
      <geom name="goal_left_side_l" type="box" pos="-0.49 -0.04 0.23" size="0.025 0.23 0.23"
            contype="1" conaffinity="1" group="3" rgba="0 0 0 0"/>
      <geom name="goal_left_side_r" type="box" pos="0.49 -0.04 0.23" size="0.025 0.23 0.23"
            contype="1" conaffinity="1" group="3" rgba="0 0 0 0"/>
    </body>

    <!-- ============ right goal (opening faces -x) ============ -->
    <body name="goal_right" pos="7.2533 0 0" euler="0 0 -1.5708">
      <geom name="goal_right_vis" type="mesh" mesh="goal_mesh"
            contype="0" conaffinity="0" group="1" rgba="0.85 0.85 0.85 1"/>
      <geom name="goal_right_post_l" type="box" pos="-0.49 -0.06 0.2445" size="0.035 0.19 0.2445"
            contype="1" conaffinity="1" group="3" rgba="0 0 0 0"/>
      <geom name="goal_right_post_r" type="box" pos="0.49 -0.06 0.2445" size="0.035 0.19 0.2445"
            contype="1" conaffinity="1" group="3" rgba="0 0 0 0"/>
      <geom name="goal_right_bar" type="box" pos="0 -0.06 0.46" size="0.5 0.19 0.03"
            contype="1" conaffinity="1" group="3" rgba="0 0 0 0"/>
      <geom name="goal_right_roof" type="box" pos="0 -0.085 0.465" size="0.5 0.17 0.02"
            contype="1" conaffinity="1" group="3" rgba="0 0 0 0"/>
      <geom name="goal_right_back" type="box" pos="0 0.165 0.21" size="0.5 0.025 0.21"
            contype="1" conaffinity="1" group="3" rgba="0 0 0 0"/>
      <geom name="goal_right_side_l" type="box" pos="-0.49 -0.04 0.23" size="0.025 0.23 0.23"
            contype="1" conaffinity="1" group="3" rgba="0 0 0 0"/>
      <geom name="goal_right_side_r" type="box" pos="0.49 -0.04 0.23" size="0.025 0.23 0.23"
            contype="1" conaffinity="1" group="3" rgba="0 0 0 0"/>
    </body>

    <!-- ============ ball: standard size-5, diameter 0.22 m ============ -->
    <body name="ball" pos="0 0 0.111">
      <freejoint name="ball_joint"/>
      <geom name="ball_collision" type="sphere" size="0.11" mass="0.43"
            friction="0.7 0.005 0.001" solref="0.004 1" group="3" rgba="0 0 0 0"/>
      <geom name="ball_visual" type="mesh" mesh="ball_mesh" pos="0 0 -0.1099"
            contype="0" conaffinity="0" group="1" mass="0" rgba="0.92 0.92 0.92 1"/>
    </body>

    <!-- indoor glass walls around the grass margin (1 m high) -->
    <geom name="wall_xp" type="box" pos="8 0 0.5" size="0.02 5.5 0.5"
          rgba="0.65 0.8 0.9 0.15"/>
    <geom name="wall_xn" type="box" pos="-8 0 0.5" size="0.02 5.5 0.5"
          rgba="0.65 0.8 0.9 0.15"/>
    <geom name="wall_yp" type="box" pos="0 5.5 0.5" size="8 0.02 0.5"
          rgba="0.65 0.8 0.9 0.15"/>
    <geom name="wall_yn" type="box" pos="0 -5.5 0.5" size="8 0.02 0.5"
          rgba="0.65 0.8 0.9 0.15"/>

    <camera name="side" pos="0 -12 5" quat="0.815583 0.578640 0 0"/>
    <camera name="top" pos="0 0 13"/>
    <camera name="goal_line" pos="-11 -6 3" quat="0.658520 0.552971 -0.328262 -0.390919"/>
  </worldbody>
</mujoco>
