<mujoco model="k1_soccer_14x9">
  <!-- Merged scene for the kick_amp sim2sim task: Booster K1 (22 dof) on the
       14x9 m soccer field from booster_assets/scene/soccer_field_14x9.xml.

       Everything is copied verbatim from the two source files except:
       - robot ground plane / checker plane / robot lights removed (the field
         plane and its lights replace them);
       - hip_roll actuator forcerange fixed 43 -> 76 Nm (E4315, the value the
         post-651b7a5 actuator model trains with; the URDF/xml still carried
         the stale 43, see booster_train Project.md "known limitations");
       - head joint armature 0.002 -> 0.001 (HT4438 value the training
         actuator model writes into PhysX);
       - goal + wall collision geoms disabled (contype/conaffinity 0):
         training's goals and field have NO collision volumes -- goals are
         judged geometrically (commands.py ball_in_goal) and out balls just
         leave the field. The stock soccer scene's physical mini-goal (mouth
         |y| < 0.455, bar 0.49 m) would block ~24% of the training scoring
         band and its net would trap balls the training geometry counts as out;
       - solver settings taken from K1_22dof.xml (impratio 10, Newton), which
         the existing k1_mj2 sim2sim path uses;
       - mesh paths made absolute so one <compiler meshdir> serves both assets.

       Field axes match training mdp/commands.py: x in [-7, 7], y in [-4.5, 4.5],
       goal mouth |y| < 1.3 at x = +7, ball r = 0.11 m, m = 0.43 kg. -->

  <compiler angle="radian"
             meshdir="../../../../assets/robots/K1/meshes"
             autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" impratio="10" solver="Newton" tolerance="1e-6"/>
  <default>
    <geom solimp="0.90 0.95 0.001" solref="0.001 1"/>
  </default>

  <visual>
    <global offwidth="1280" offheight="720"/>
  </visual>

  <statistic center="0 0 0.5" extent="10"/>

  <asset>
    <texture type="skybox" name="sky" builtin="gradient"
             rgb1="0.72 0.78 0.85" rgb2="0.95 0.96 0.97" width="512" height="512"/>
    <texture type="2d" name="grass_tex"
             file="../../../../assets/scene/grass_14x9.png"/>
    <material name="grass_mat" texture="grass_tex" texuniform="true"
              texrepeat="0.125 0.189" specular="0.1" shininess="0.15"
              reflectance="0.02"/>
    <mesh name="goal_mesh" file="../../../../assets/scene/goal.stl"/>
    <mesh name="ball_mesh" file="../../../../assets/scene/footaball.stl"
          scale="0.18514 0.18514 0.18514"/>

    <!-- K1 meshes (verbatim from robots/K1/K1_22dof.xml, relative to meshdir) -->
